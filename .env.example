# Copier en .env.local et compléter (Supabase > Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète : serveur uniquement, ne jamais exposer côté client.
SUPABASE_SECRET_KEY=sb_secret_xxx
# URL publique de l'app (liens envoyés par e-mail, redirections OAuth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
